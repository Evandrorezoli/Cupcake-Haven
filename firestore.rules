rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    function isValidUser(data) {
      return data.uid is string &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['customer', 'admin'];
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && incoming().role == 'customer';
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().role == existing().role && // Users cannot change their own role
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // --- Products ---
    function isValidProduct(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.imageUrl is string;
    }

    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // --- Orders ---
    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'] &&
             data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().status == 'pending';
      allow update: if (isAdmin() && isValidOrder(incoming())) || 
                    (isSignedIn() && resource.data.userId == request.auth.uid && 
                     incoming().status == 'confirmed' && 
                     existing().status == 'pending' &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['status']));
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'pending';
    }

    // --- Favorites ---
    match /favorites/{userId}/items/{itemId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidId(itemId);
    }

    // --- Addresses ---
    function isValidAddress(data) {
      return data.street is string && data.street.size() <= 200 &&
             data.number is string && data.number.size() <= 20 &&
             data.neighborhood is string && data.neighborhood.size() <= 100 &&
             data.city is string && data.city.size() <= 100 &&
             data.state is string && data.state.size() <= 2 &&
             data.zipCode is string && data.zipCode.size() <= 20;
    }

    match /users/{userId}/addresses/{addressId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(addressId) && isValidAddress(incoming());
      allow update: if isOwner(userId) && isValidAddress(incoming());
      allow delete: if isOwner(userId);
    }
  }
}
